{
  "name": "cityflow-ai-web",
  "version": "0.1.0",
  "private": true,
  "description": "CityFlow AI \u2014 Smarter Departures, Smoother Journeys. Web application (user portal + admin portal).",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "admin:create": "node --env-file=.env scripts/make-admin.mjs",
    "demo:seed": "node --env-file=.env scripts/demo-seed.mjs",
    "demo:clear": "node --env-file=.env scripts/demo-seed.mjs --clear",
    "demo:check": "node --env-file=.env scripts/demo-check.mjs",
    "sumo:export": "node --env-file=.env scripts/sumo-export.mjs",
    "demo:optimise": "node --env-file=.env scripts/reoptimise.mjs",
    "role:set": "node --env-file=.env scripts/set-role.mjs",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@prisma/client": "6.3.0",
    "bcryptjs": "2.4.3",
    "jose": "5.9.6",
    "leaflet": "1.9.4",
    "next": "16.3.4",
    "react-leaflet": "5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@swc/core": "1.10.7",
    "@swc/jest": "0.2.37",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcryptjs": "2.4.6",
    "@types/jest": "29.5.14",
    "@types/leaflet": "1.9.16",
    "@types/node": "22.10.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jest": "29.7.0",
    "postcss": "^8.5.23",
    "prisma": "6.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3"
  }
}
