# =============================================================================
# CityFlow AI — ML service settings
# =============================================================================
# Copy this file to ".env" in the same folder and edit the values.
# Every setting has a working default, so the service starts with none of them.
# =============================================================================

# "development" or "production".
# In production the service REFUSES TO START without CITYFLOW_API_KEY set.
CITYFLOW_ENVIRONMENT="development"

# Shared secret. The Next.js app must send the same value as the
# X-CityFlow-Key header. Generate one with:  openssl rand -hex 32
CITYFLOW_API_KEY=""

# Redis, for caching forecasts. Leave blank to run without a cache.
# With Docker Compose this is:  redis://redis:6379/0
CITYFLOW_REDIS_URL=""
CITYFLOW_CACHE_TTL_SECONDS="300"

# --- Optimiser tuning --------------------------------------------------------
# Raise PEAK_WEIGHT to smooth harder (more people moved).
# Raise DISRUPTION_WEIGHT to protect routines (fewer people moved, further).
CITYFLOW_PEAK_WEIGHT="100"
CITYFLOW_DISRUPTION_WEIGHT="1"

CITYFLOW_MAX_COMMUTERS="5000"
CITYFLOW_SOLVER_TIMEOUT_SECONDS="10"
